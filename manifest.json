{
  "manifest_version": 3,
  "name": "Promptica",
  "version": "1.0",
  "description": "Construa prompts claros para IA com um checklist guiado.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://gemini.googleapis.com/*",
    "https://*.supabase.co/*"
  ]
}